{
  "name": "null-uprising",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A real PixiJS 3D platform-fighter meets belt-scrolling android uprising.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview --host 0.0.0.0",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@pixi/3d": "0.1.0",
    "pixi.js": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  }
}
